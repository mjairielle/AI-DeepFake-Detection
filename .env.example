# ─────────────────────────────────────────────────────────────────
#  DeepScan AI — Environment Variables
# ─────────────────────────────────────────────────────────────────
#  Copy this file to .env and fill in the values.
#  On Vercel, set these in Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────

# HMAC key for signing learning data (hex-encoded, 64 hex chars = 32 bytes).
# Generate one with: python -c "import os; print(os.urandom(32).hex())"
# If not set, a random key is generated on first run (ephemeral on Vercel).
HMAC_SECRET_KEY=

# Flask settings (optional, used by main.py / local dev only)
HOST=127.0.0.1
PORT=5000
DEBUG=false
